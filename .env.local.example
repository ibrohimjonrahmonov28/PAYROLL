# Django Local Development Environment Variables
SECRET_KEY=django-insecure-local-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database (Docker ichidagi sozlamalar)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=payroll_db
DB_USER=payroll_user
DB_PASSWORD=payroll_secure_pass
DB_HOST=db
DB_PORT=5432

# Telegram Bot (Localda test qilish uchun ixtiyoriy, bo'sh qoldirsa ham ishlaydi)
BOT_TOKEN=
